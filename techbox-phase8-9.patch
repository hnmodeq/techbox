-
-        // Type out the command letter by letter
-        terminalInput.textContent = "";
-        charIdx = 0;
-        function typeLetter() {
-          if (charIdx < cmdObj.text.length) {
-            terminalInput.textContent += cmdObj.text.charAt(charIdx);
-            charIdx++;
-            setTimeout(typeLetter, 45 + Math.random() * 40);
-          } else {
-            // Command completed, hit enter and show output
-            setTimeout(() => {
-              const cmdLine = document.createElement('div');
