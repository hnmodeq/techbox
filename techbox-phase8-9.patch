-    // 3. Realtime SVG Spline Line Chart Generator
-    const svgChart = document.getElementById('live-svg-chart');
-    const chartArea = document.getElementById('chart-area');
-    const chartLine = document.getElementById('chart-line');
-    const chartPulse = document.getElementById('chart-pulse');
-    const throughputVal = document.getElementById('throughput-val');
-    const cpuLoadVal = document.getElementById('cpu-load-val');
-
-    let chartPoints = [80, 110, 95, 120, 85, 105, 75, 90, 60];
-
-    function updateLiveChart() {
-      // Shift array and add new randomized natural telemetry point
-      chartPoints.shift();
-      const lastVal = chartPoints[chartPoints.length - 1];
-      const change = (Math.random() - 0.48) * 35;
-      let nextVal = Math.round(lastVal + change);
-      if (nextVal < 20) nextVal = 30;
-      if (nextVal > 140) nextVal = 120;
-      chartPoints.push(nextVal);
-
-      // Generate SVG Spline representation
-      const width = 400;
-      const height = 150;
-      const step = width / (chartPoints.length - 1);
-      
-      let dLine = `M 0 ${chartPoints[0]}`;
-      for (let i = 1; i < chartPoints.length; i++) {
-        const x = i * step;
-        const y = chartPoints[i];
-        const prevX = (i - 1) * step;
-        const prevY = chartPoints[i - 1];
-        // Smooth Bezier Curve controls
-        const cpX1 = prevX + step / 2;
-        const cpY1 = prevY;
-        const cpX2 = prevX + step / 2;
-        const cpY2 = y;
-        dLine += ` C ${cpX1} ${cpY1}, ${cpX2} ${cpY2}, ${x} ${y}`;
-      }
-
-      const dArea = `${dLine} L 400 150 L 0 150 Z`;
-
-      // Update Path DOM attributes
-      chartLine.setAttribute('d', dLine);
-      chartArea.setAttribute('d', dArea);
-
-      // Position moving pulse dot at last coordinate
-      chartPulse.setAttribute('cx', 400);
-      chartPulse.setAttribute('cy', nextVal);
-
-      // Update numerical indicators
-      const throughput = Math.round(450 + (150 - nextVal) * 2.2);
-      const cpu = Math.round(20 + (150 - nextVal) * 0.4);
-      throughputVal.textContent = `${throughput} MB/s`;
-      cpuLoadVal.textContent = `${cpu}.4%`;
-
-      // Sync active clock
-      const now = new Date();
-      document.getElementById('current-time').textContent = now.toLocaleTimeString();
-
-      // Trigger log entry occasionally
-      if (Math.random() > 0.75) {
-        addLogEntry('TELEMETRY', `Metrics updated: cpu ${cpu}%, throughput ${throughput}MB/s`, 'info');
-      }
-    }
-
-    setInterval(updateLiveChart, 1500);
