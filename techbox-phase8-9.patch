-
-    function runTerminalTyping() {
-      if (currentCmdIdx >= terminalCommands.length) {
-        currentCmdIdx = 0;
-      }
-      
-      const cmdObj = terminalCommands[currentCmdIdx];
-      
-      if (cmdObj.isCommand) {
-        // Clear screen command
-        if (cmdObj.clear) {
-          setTimeout(() => {
-            terminalLogs.innerHTML = "";
-            terminalInput.textContent = "";
-            currentCmdIdx++;
-            charIdx = 0;
-            runTerminalTyping();
-          }, 1500);
-          return;
