# Copy to .env for local development. Never commit real values.

# Auth — required everywhere auth code runs; at least 32 characters.
# Generate a unique value per environment, for example: openssl rand -base64 48
AUTH_SECRET=""

# Canonical origin. Local HTTP is allowed only outside production.
# Vercel Production must use the exact public HTTPS origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon PostgreSQL — pooled runtime URL (`-pooler` host). Include sslmode=require,
# connection_limit=1, pool_timeout=15, and connect_timeout=15.
DATABASE_URL=""

# Neon PostgreSQL — direct/non-pooled URL for Prisma migrations. Include
# sslmode=require and connect_timeout=15.
DIRECT_URL=""
# Development pool size. In dev, lib/db.ts OVERRIDES any connection_limit in
# DATABASE_URL with this value (default 8) — one long-lived dev process serves
# the page render and every /api/* call concurrently, and a pool of 1 makes
# them queue until pool_timeout and fail P2024. Production always honours the
# URL, where one connection per serverless instance is correct.
PRISMA_CONNECTION_LIMIT="8"

# Supabase Storage — service-role key is server-only. Never use NEXT_PUBLIC_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="techbox"
SUPABASE_PRIVATE_BUCKET="job-resumes"
# One-time importer gate. Keep false unless QNAP asset-use authorization is confirmed.
QNAP_ASSET_IMPORT_AUTHORIZED="false"

# Scheduled publishing bearer token.
CRON_SECRET=""

# Email (Resend by default; Nodemailer credentials are managed in admin settings).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TechBox <noreply@example.com>"
CONTACT_EMAIL="hello@example.com"

# Distributed production rate limiting (strongly recommended in production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OpenAI-compatible chat provider (server-only).
CHAT_API_KEY=""
CHAT_BASE_URL="https://api.openai.com/v1"
CHAT_MODEL="gpt-4o-mini"

# Sentry monitoring. SENTRY_AUTH_TOKEN is needed only where source maps upload.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Payments — merchant ID is required for live checkout.
ZARIN_MERCHANT_ID=""
# Use true only in an explicit non-production payment environment.
ZARINPAL_SANDBOX="false"

# Seed script only; do not use a production account password here.
# SEED_DEFAULT_PASSWORD=""

# Optional integrity-check limit used by CI/operations.
STORAGE_CHECK_LIMIT="200"

# Set to 1 to bypass Next's server-side image optimizer and let the browser
# fetch images directly. Needed on networks where DNS for the image host is
# poisoned (Iranian ISPs resolve blocked domains to 10.10.34.x, which Next
# rejects as a private IP). Browsers use DNS-over-HTTPS and are unaffected.
# Leave UNSET in production so optimization stays on.
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=""
