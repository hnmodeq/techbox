{
  "name": "techbox",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --webpack",
    "dev:clean": "node scripts/clean-dev-cache.mjs && prisma generate && next dev --webpack",
    "clean": "node scripts/clean-dev-cache.mjs",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "scan:secrets": "gitleaks detect --config .gitleaks.toml --redact --verbose",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "db:push": "prisma db push",
    "db:doctor": "tsx scripts/checks/db-connect.ts",
    "db:size": "tsx scripts/checks/db-size.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0_init/migration.sql && prisma migrate resolve --applied 0_init",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-job-titles": "tsx prisma/seed-job-titles.ts",
    "db:seed-roles": "tsx prisma/seed-roles.ts",
    "db:seed-tags": "tsx prisma/seed-tags.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:backfill-metadata": "tsx prisma/backfill-metadata.ts",
    "db:fix-future-dates": "tsx prisma/fix-future-post-dates.ts",
    "storage:migrate-resumes": "tsx scripts/migrate-resumes-to-supabase-private.ts",
    "storage:import-qnap": "tsx scripts/import-qnap-product-images.ts",
    "content:remove-retired": "tsx scripts/remove-retired-content.ts",
    "content:populate-home": "tsx scripts/content/populate-homepage-content.ts",
    "content:sync-visuals": "tsx scripts/content/sync-seed-visuals.ts",
    "check:content": "tsx scripts/checks/content.ts",
    "check:storage": "tsx scripts/checks/storage.ts",
    "check:db": "tsx scripts/checks/db.ts",
    "check:all": "tsx scripts/checks/all.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "playwright:install": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:webpack": "prisma generate && next dev --webpack",
    "dev:turbo": "prisma generate && next dev",
    "dev:turbo:clean": "node scripts/clean-dev-cache.mjs && prisma generate && next dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@sentry/nextjs": "^10.64.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "jose": "^5.10.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.3",
      "fast-uri": "^3.1.4",
      "brace-expansion": "^1.1.17"
    }
  }
}
